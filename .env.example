# ===== 复制本文件为 .env 并填写自己的值 =====

# DeepSeek API Key（https://platform.deepseek.com 获取；留空则问答接口使用 Mock 模式）
DEEPSEEK_API_KEY=

# DeepSeek 接口地址与模型
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 生成温度（0~1，越低越严谨）与多轮对话携带的历史消息条数
LLM_TEMPERATURE=0.3
RAG_HISTORY_LIMIT=10

# 向量化模型（fastembed 本地推理，首次调用自动下载约 100MB）
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5

# HuggingFace 镜像（国内下载模型慢可填 https://hf-mirror.com；留空走官方源）
HF_ENDPOINT=

# 数据库连接（默认本地 SQLite）
DATABASE_URL=sqlite:///./kb.db

# 调试模式
DEBUG=false
